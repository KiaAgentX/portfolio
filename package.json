{
  "name": "kia-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static portfolio site: index of 48 projects with live previews and in-site source viewer.",
  "scripts": {
    "vendor": "node scripts/vendor-hljs.mjs",
    "scan": "node scripts/scan.mjs .. ./scan.json",
    "build": "node scripts/build.mjs",
    "build:previews": "node scripts/build-previews.mjs",
    "build:all": "npm run build:previews && npm run build",
    "serve": "python -m http.server 8877 --directory dist",
    "test": "node scripts/test-site.mjs",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.1.1"
  }
}
