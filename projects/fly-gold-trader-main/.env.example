# --- AI analysis (optional) ---
TYPESAFE_API_KEY=your_api_key_here

# --- MetaTrader 5 (live mode only, Windows) ---
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_server

# --- Trading mode: paper (simulator, default) | live (real MT5) ---
TRADE_MODE=paper
SIM_SPEED=30
SIM_SEED=20240101

# --- Strategy: ensemble | fly_momentum | ema_cross | rsi_reversal |
#     bollinger_fade | macd_momentum | candle_pattern | multi_tf_trend
STRATEGY=ensemble

# --- Execution ---
BASE_VOLUME=0.01
MAX_POSITIONS=5
TP_USD=8.0
SL_USD=4.0
TRAIL_USD=3.0
LOOP_DELAY=2
SPREAD_MAX=0

# --- Risk manager ---
RISK_PCT=0.5
MAX_DAILY_LOSS_USD=60
MAX_DRAWDOWN_PCT=10
COOLDOWN_AFTER_LOSSES=3
COOLDOWN_SEC=300
SESSION_START=0
SESSION_END=24

# --- Notifications (optional) ---
NOTIFY_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# --- Server ---
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me
AUTO_START=0
FLY_ROOT=
