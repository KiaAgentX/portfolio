# --- LLM provider (at least one required) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Chat platform (at least one required) ---
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# --- Agent server ---
# PORT=8000
# PUBLIC_URL=https://your-service.up.railway.app
# API_SERVER_KEY=change-me
# WEBHOOK_SECRET=change-me
# HERMES_API_KEY=change-me

# --- Radius / ERC-8004 (testnet defaults are safe to keep) ---
# RADIUS_PRIVATE_KEY=0x...
# NETWORK=testnet
# MAINNET_RPC_URL=https://...
# MAINNET_REGISTRY=0x...
# MAINNET_CHAIN_ID=...
# MAINNET_EXPLORER_URL=https://...
# GAS_LIMIT=2000000
# MAX_AGENT_URI_BYTES=8192
