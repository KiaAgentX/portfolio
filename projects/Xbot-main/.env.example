# ============================================================
# LaunchBot v2 «دوجهانه» — Railway Variables (or local .env)
# روش استفاده: همه‌ی خط‌های پایین رو کپی کن توی
# Railway → Variables → RAW editor، فقط ۵ تا FILL-ME رو پر کن، Deploy.
# بقیه با همین مقادیر ۱۰۰٪ کار می‌کنن.
# NEVER commit real keys to git!
# ============================================================

# ================= 1) REQUIRED — این ۵ تا رو حتماً پر کن =================
# از BotFather بگیر: به @BotFather پیام بده → /newbot → اسم بده → توکن رو کپی کن
TELEGRAM_BOT_TOKEN=FILL-ME-from-BotFather
# کلید 9router (چت رایگان) یا OpenAI:
OPENAI_API_KEY=FILL-ME-9router-or-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
# اگه 9router داری، خط بالا رو عوض کن به آدرس روترت، مثلاً:
# OPENAI_BASE_URL=https://<your-9router-host>/v1
CHAT_MODEL=gpt-4o-mini
# آیدی عددی مدیرها: بعد از بالا اومدن به بات /id بده، عدد رو این‌جا بذار و Redeploy کن
# (چند مدیر: با کاما جدا کن، مثلاً 111,222)
ADMIN_IDS=FILL-ME-your-numeric-id
# لاگین پنل ادمین وب — یه رمز قوی دلخواه بذار!
WEB_PASSWORD=FILL-ME-strong-password
# سشن وب — با این دستور یکی بساز و این‌جا بذار (یدونه کافیه، عوضش نکن):
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET=FILL-ME-random-32-chars-min

# ================= 2) MEDIA — عکس و ویس ۱۰۰٪ =================
# ویس خروجی فارسی/انگلیسی رایگانه (Edge) و بدون هیچ کلیدی کار می‌کنه ✅
TTS_PROVIDER=edge
TTS_GENDER=female
DEFAULT_MODE=text
# ساخت عکس (/image) و فهم ویس از کلید اصلی استفاده می‌کنن.
# اگه کلید اصلی‌ت روتر رایگانِ فقط-متنیه، برای ۱۰۰٪ شدن این ۲ خط رو
# با کلید مستقیم OpenAI پر کن (فقط همین ۲ قابلیت بهش نیاز دارن):
# IMAGE_API_KEY=sk-...
# AUDIO_API_KEY=sk-...
IMAGE_MODEL=dall-e-3
STT_MODEL=whisper-1

# ================= 3) LAUNCHER + STORAGE =================
RUN_BOT=true
RUN_WEB=true
# ⚠️ حتماً Volume روی /app/data بساز! وگرنه سفارش/تیکت/تنظیمات با هر ری‌دیپلوی می‌پرن.
DB_PATH=data/bot.db
CATALOG_PATH=catalog.json
# آدرس عمومی بعد از دیپلوی (اختیاری — برای دکمه‌ی پنل وب داخل دستور /admin):
# BASE_URL=https://your-app.up.railway.app
# PORT رو خود Railway تزریق می‌کنه — دستی ست نکن!

# ================= 4) TUNING — پیش‌فرض‌ها خوبن، لازم نیست دست بزنی =================
# (همه‌ی این‌ها رو بعداً هم می‌تونی از داخل بات با /set یا پنل وب عوض کنی — بدون ری‌دیپلوی!)
# MAX_TOKENS=1500
# TEMPERATURE=0.7
# MAX_HISTORY=30
# SYSTEM_PROMPT=see DEFAULT_SYSTEM_PROMPT in config.py
# EDGE_RATE=+0%
# FA_THRESHOLD=0.2
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# EDGE_VOICE_FA_FEMALE=fa-IR-DilaraNeural
# EDGE_VOICE_FA_MALE=fa-IR-FaridNeural
# EDGE_VOICE_EN_FEMALE=en-US-AvaNeural
# EDGE_VOICE_EN_MALE=en-US-AndrewNeural
# IMAGE_BASE_URL=
# AUDIO_BASE_URL=
# ALLOWED_USER_IDS=  (خالی = بات عمومی برای همه)
# زبان پیش‌فرض پلتفرم (fa یا en) — هر یوزر با /lang یا سوییچ وب عوضش می‌کنه
# LAUNCH_LANG=fa
