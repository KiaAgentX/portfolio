# GQR Institutional V3.3 Environment Variables
# Copy to .env and fill in your credentials

# Data paths
GQR_DATA_FEEDER__SYMBOLS=["XAUUSD","EURUSD","DXY"]
GQR_DATA_FEEDER__TIMEFRAME=M1
GQR_DATA_FEEDER__LOOKBACK_BARS=500
GQR_DATA_FEEDER__BACKTEST_CSV_PATH=data/raw
GQR_DATA_FEEDER__PRECOMPUTED_FEATURES_PATH=data/processed

# Execution
GQR_EXECUTION_ENGINE__MAGIC_NUMBER=888888
GQR_EXECUTION_ENGINE__SLIPPAGE_TOLERANCE=10
GQR_EXECUTION_ENGINE__COMMISSION_PER_LOT=7.0
GQR_EXECUTION_ENGINE__RISK_PER_TRADE_PCT=0.01

# Risk Management
GQR_RISK_MANAGEMENT__MAX_DAILY_DRAWDOWN=0.05
GQR_RISK_MANAGEMENT__MAX_WEEKLY_DRAWDOWN=0.10
GQR_RISK_MANAGEMENT__SPREAD_FILTER=30.0
GQR_RISK_MANAGEMENT__MAX_VOLATILITY=0.05
GQR_RISK_MANAGEMENT__FIXED_LOT_SIZE=0.01
GQR_RISK_MANAGEMENT__USE_DYNAMIC_LOT=true
GQR_RISK_MANAGEMENT__MAX_CORRELATION_EXPOSURE=0.7

# Model
GQR_MODEL__EMBED_DIM=256
GQR_MODEL__N_HEADS=8
GQR_MODEL__N_LAYERS=4
GQR_MODEL__DROPOUT=0.1
GQR_MODEL__MAX_SEQ_LEN=200

# Reinforcement Learning
GQR_RL__LEARNING_RATE=0.00003
GQR_RL__GAMMA=0.99
GQR_RL__GAE_LAMBDA=0.95
GQR_RL__CLIP_RANGE=0.2
GQR_RL__ENTROPY_COEFF=0.01
GQR_RL__VALUE_COEFF=0.5
GQR_RL__EPOCHS=5
GQR_RL__BATCH_SIZE=256
GQR_RL__TRAIN_EVERY_N_STEPS=1024

# Backtest
GQR_BACKTEST__INITIAL_CAPITAL=10000.0
GQR_BACKTEST__START_DATE=2020-01-01
GQR_BACKTEST__END_DATE=2023-12-31
GQR_BACKTEST__OUTPUT_REPORT_PATH=reports/backtest_report.html

# Monitoring
GQR_MONITORING__DASHBOARD_PORT=8501
# GQR_MONITORING__TELEGRAM_BOT_TOKEN=
# GQR_MONITORING__TELEGRAM_CHAT_ID=
# GQR_MONITORING__DISCORD_WEBHOOK_URL=
GQR_MONITORING__ALERT_ON_DRAWDOWN=true
GQR_MONITORING__ALERT_ON_ORDER=false

# General
GQR_PROJECT_NAME=GQR-Institutional
GQR_VERSION=3.3.0
GQR_LOG_LEVEL=INFO
GQR_YAML_CONFIG_PATH=configs/settings.yaml
GQR_SIMULATION_ONLY=true