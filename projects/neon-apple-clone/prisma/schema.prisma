generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  price       Float
  image       String
  category    String
  accentColor String   @default("#00ffd5")
  badge       String?
  featured    Boolean  @default(false)
  hero        Boolean  @default(false)
  sortOrder   Int      @default(0)
  specs       String   @default("[]")
  highlights  String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bagItems BagItem[]
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model BagItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
}

model Stat {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}
