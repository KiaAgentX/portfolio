APP_ENV=dev
TENANT_ID=default
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

DATABASE_URL=postgresql+asyncpg://hermes:hermes@postgres:5432/hermesdesk
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hermesdesk
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-minio
S3_FORCE_PATH_STYLE=true

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o
ROUTER_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

HERMES_BASE_URL=http://hermes:8088/v1
HERMES_API_KEY=hermes-local-key

TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_CUSTOMER_SECRET_TOKEN=change-me-telegram-secret
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_SECRET_TOKEN=change-me-admin-secret
TELEGRAM_ADMIN_USER_IDS=

WHATSAPP_PROVIDER=meta
META_WABA_TOKEN=
META_WABA_PHONE_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-meta-verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=desk@example.com
EMAIL_INBOUND_SECRET=change-me-email-secret

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_EMAIL=admin@local
ADMIN_BOOTSTRAP_PASSWORD=changeme
APPROVAL_TIMEOUT_SEC=600
ACK_ON_INGEST=true
EMBED_TICKETS=false
DEV_INLINE_JOBS=false
