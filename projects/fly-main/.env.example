# ============================================================
# FISHKAL — ENVIRONMENT VARIABLES (example)
# Copy to .env and fill values. NEVER commit real secrets.
# ============================================================

# ---- Database (PostgreSQL via docker-compose) ----
POSTGRES_USER=fishkal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fishkal
DATABASE_URL="postgresql://fishkal:change_me@localhost:5432/fishkal?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API server ----
# Port the API listens on in development
API_PORT=4000
# Public origin of the website (CORS)
WEBSITE_ORIGIN="http://localhost:3000"

# ---- Telegram (optional in Phase 1) ----
# Bot token from @BotFather. Leave empty to run without Telegram features.
TELEGRAM_BOT_TOKEN=
# Secret used to sign/verify session tokens issued by the API
SESSION_SECRET=change_me_session_secret

# ---- Storage (assets) — Phase 2 ----
# S3-compatible bucket for GLB/textures/audio in production
# ASSETS_S3_ENDPOINT=
# ASSETS_S3_BUCKET=
# ASSETS_PUBLIC_CDN_BASE=
