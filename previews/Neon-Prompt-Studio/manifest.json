      "label": "Neon Prompt Studio — Desktop View"
    },
    {
      "src": "./screenshot-mobile.jpg",
      "sizes": "375x812",
      "type": "image/jpeg",
      "label": "Neon Prompt Studio — Mobile View",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Prompts",
      "short_name": "Browse",
      "description": "Browse all creative prompts",
      "url": "./",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add Custom Prompt",
      "short_name": "Add",
      "description": "Create a new custom prompt",
      "url": "./?action=add",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Random Prompt",
      "short_name": "Random",
      "description": "Get a random prompt for inspiration",
      "url": "./?action=random",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Favorites",
      "short_name": "Favs",
      "description": "View your favorite prompts",
      "url": "./?action=favorites",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "scope": "./",
  "serviceworker": {
    "src": "./service-worker.js",
    "scope": "./",
    "type": "classic"
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "capture_links": "new-client",
  "protocol_handlers": [
    {
      "protocol": "web+neon",
      "url": "./?prompt=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}