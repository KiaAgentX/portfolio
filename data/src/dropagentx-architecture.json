Tools & Infra -->\n  <div class=\"layer l-service\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">🔧</div>\n      <div><div class=\"layer-title\">Tools & Infra — ابزارها و زیرساخت</div><div class=\"layer-count\">7 files</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">utils.py</span><span class=\"fd\">utilities</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">cron_jobs.py</span><span class=\"fd\">scheduled jobs</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">treasury_worker.py</span><span class=\"fd\">treasury ops</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">tools_seed_skills.py</span><span class=\"fd\">skill seeding</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">tools_seed_demo.py</span><span class=\"fd\">demo data</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">tools_capacity_sim.py</span><span class=\"fd\">capacity sim</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">tools_db_doctor.py</span><span class=\"fd\">DB health</span></div>\n    </div>\n  </div>\n\n  <!-- LAYER 6: Shared -->\n  <div class=\"layer l-shared\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">🔗</div>\n      <div><div class=\"layer-title\">Shared Layer — ماژول‌های مشترک</div><div class=\"layer-count\">3 modules · shared/</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🩷</span><span class=\"fn\">context_compressor.py</span><span class=\"fd\">shared/context/</span></div>\n      <div class=\"file\"><span class=\"fi\">🩷</span><span class=\"fn\">router_client.py</span><span class=\"fd\">shared/llm/</span></div>\n      <div class=\"file\"><span class=\"fi\">🩷</span><span class=\"fn\">skills_guard.py</span><s