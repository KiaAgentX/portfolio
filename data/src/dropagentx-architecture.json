{"files":[{"path":"README.md","lang":"markdown","size":440,"truncated":false,"content":"# DropAgentX — معماری پروژه\n\nسند معماری کامل پلتفرم DropAgentX: سرویس‌ها، جریان داده، گیت‌های LLM و توپولوژی استقرار در یک سند بصری.\n\n## Kit\n\n- HTML\n- Docs\n\n## اجرا\n\n```bash\n# مستقیم در مرورگر باز کنید، یا:\npython -m http.server 8000\n```\n\n> سند داخلی/استراتژیک — تک‌فایل، بدون وابستگی.\n"},{"path":"index.html","lang":"xml","size":39914,"truncated":false,"content":"<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>DropAgentX — معماری پروژه</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--cyan:#22d3ee;--purple:#a78bfa;--green:#34d399;--gold:#fbbf24;--pink:#f472b6;--red:#f87171;--orange:#fb923c;--bg:#06060e;--s:rgba(12,12,24,.92);--b:rgba(255,255,255,.06);--t:#e4e4e7;--d:#71717a}\n*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{font-family:'Vazirmatn','Inter',sans-serif;background:var(--bg);color:var(--t);min-height:100vh;overflow-x:hidden}\nbody::before{content:'';position:fixed;inset:0;z-index:-1;background:radial-gradient(ellipse at 20% 0%,rgba(34,211,238,.06) 0%,transparent 50%),radial-gradient(ellipse at 80% 100%,rgba(167,139,250,.04) 0%,transparent 50%)}\n\n.hero{padding:60px 20px 40px;text-align:center;max-width:1100px;margin:0 auto}\n.hero-badge{display:inline-block;padding:5px 16px;border-radius:20px;background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.25);color:var(--purple);font-size:.72rem;font-weight:600;margin-bottom:20px;font-family:'JetBrains Mono',monospace;letter-spacing:1px}\n.hero h1{font-size:clamp(2rem,5.5vw,3.5rem);font-weight:900;line-height:1.1;margin-bottom:12px}\n.hero h1 .g{background:linear-gradient(135deg,var(--cyan),var(--purple));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}\n.hero .sub{font-size:.95rem;color:var(--d);max-width:620px;margin:0 auto 24px;line-height:1.8}\n\n.kpi-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--b);border-radius:14px;overflow:hidden;margin:0 auto 40px;max-width:1100px}\n.kpi{background:var(--s);padding:18px 8px;text-align:center}\n.kpi .v{font-family:'JetBrains Mono',monospace;font-size:1.3rem;font-weight:700}\n.kpi .l{font-size:.62rem;color:var(--d);margin-top:3px}\n.kpi.c .v{color:var(--cyan)}.kpi.p .v{color:var(--purple)}.kpi.g .v{color:var(--green)}.kpi.o .v{color:var(--orange)}.kpi.pk .v{color:var(--pink)}\n\n.wrap{max-width:1100px;margin:0 auto;padding:0 20px}\n\n/* ── ARCHITECTURE DIAGRAM ── */\n.arch{margin:50px 0}\n.arch>h2{text-align:center;font-size:1.6rem;font-weight:800;margin-bottom:6px}\n.arch>.sub-h{text-align:center;color:var(--d);margin-bottom:32px;font-size:.85rem}\n\n/* Layer blocks */\n.layer{background:var(--s);border:1px solid var(--b);border-radius:18px;padding:24px;margin-bottom:20px;position:relative;overflow:hidden}\n.layer::before{content:'';position:absolute;top:0;right:0;width:4px;height:100%;border-radius:0 0 0 4px}\n.layer.l-entry::before{background:var(--cyan)}\n.layer.l-core::before{background:var(--purple)}\n.layer.l-handler::before{background:var(--green)}\n.layer.l-service::before{background:var(--gold)}\n.layer.l-shared::before{background:var(--pink)}\n.layer.l-web::before{background:var(--orange)}\n.layer.l-test::before{background:var(--red)}\n\n.layer-head{display:flex;align-items:center;gap:10px;margin-bottom:16px}\n.layer-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}\n.l-entry .layer-icon{background:rgba(34,211,238,.1);color:var(--cyan)}\n.l-core .layer-icon{background:rgba(167,139,250,.1);color:var(--purple)}\n.l-handler .layer-icon{background:rgba(52,211,153,.1);color:var(--green)}\n.l-service .layer-icon{background:rgba(251,191,36,.1);color:var(--gold)}\n.l-shared .layer-icon{background:rgba(244,114,182,.1);color:var(--pink)}\n.l-web .layer-icon{background:rgba(251,146,60,.1);color:var(--orange)}\n.l-test .layer-icon{background:rgba(248,113,113,.1);color:var(--red)}\n\n.layer-title{font-weight:700;font-size:1rem}\n.layer-count{font-size:.68rem;color:var(--d);font-family:'JetBrains Mono',monospace}\n\n/* File grid */\n.file-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px}\n.file{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:10px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.03);font-size:.78rem;transition:border-color .2s}\n.file:hover{border-color:rgba(167,139,250,.15)}\n.file .fi{font-size:.85rem;flex-shrink:0}\n.file .fn{font-family:'JetBrains Mono',monospace;font-size:.72rem;color:#a1a1aa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.file .fd{font-size:.62rem;color:var(--d);margin-right:auto}\n\n/* ── TREE VIEW ── */\n.tree-section{margin:50px 0}\n.tree-section>h2{text-align:center;font-size:1.6rem;font-weight:800;margin-bottom:6px}\n.tree-section>.sub-h{text-align:center;color:var(--d);margin-bottom:28px;font-size:.85rem}\n\n.tree{background:var(--s);border:1px solid var(--b);border-radius:18px;padding:28px 24px;font-family:'JetBrains Mono',monospace;font-size:.72rem;line-height:2;direction:ltr;text-align:left;overflow-x:auto}\n.tree .dir{color:var(--cyan);font-weight:700}\n.tree .file-py{color:var(--green)}\n.tree .file-js{color:var(--gold)}\n.tree .file-css{color:var(--pink)}\n.tree .file-other{color:var(--d)}\n.tree .comment{color:#52525b;font-style:italic}\n.tree .highlight{background:rgba(167,139,250,.08);padding:2px 6px;border-radius:4px}\n\n/* ── DATA FLOW ── */\n.flow-section{margin:50px 0}\n.flow-section>h2{text-align:center;font-size:1.6rem;font-weight:800;margin-bottom:6px}\n.flow-section>.sub-h{text-align:center;color:var(--d);margin-bottom:28px;font-size:.85rem}\n\n.flow{display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;padding:20px 0}\n.flow-node{background:var(--s);border:1px solid var(--b);border-radius:14px;padding:16px 18px;text-align:center;min-width:120px;position:relative}\n.flow-node .fi{font-size:1.4rem;margin-bottom:6px}\n.flow-node .fn{font-size:.78rem;font-weight:600}\n.flow-node .fd{font-size:.62rem;color:var(--d);margin-top:2px}\n.flow-arrow{color:var(--d);font-size:1.2rem;padding:0 6px;flex-shrink:0}\n.flow-wrap{display:flex;flex-direction:column;align-items:center;gap:20px;width:100%;max-width:900px;margin:0 auto}\n.flow-row{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:0}\n\n/* ── STATS BOX ── */\n.stats-box{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin:40px 0}\n.stat-card{background:var(--s);border:1px solid var(--b);border-radius:14px;padding:20px;text-align:center}\n.stat-card .sn{font-family:'JetBrains Mono',monospace;font-size:2rem;font-weight:700}\n.stat-card .sl{font-size:.75rem;color:var(--d);margin-top:4px}\n.stat-card.s1 .sn{color:var(--cyan)}.stat-card.s2 .sn{color:var(--purple)}.stat-card.s3 .sn{color:var(--green)}.stat-card.s4 .sn{color:var(--gold)}.stat-card.s5 .sn{color:var(--pink)}.stat-card.s6 .sn{color:var(--orange)}\n\n/* ── SKILLS GRID ── */\n.skills-section{margin:40px 0}\n.skills-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:8px}\n.skill-chip{padding:10px 14px;border-radius:10px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.03);font-size:.75rem;text-align:center;transition:border-color .2s}\n.skill-chip:hover{border-color:rgba(52,211,153,.2)}\n.skill-chip .sfi{font-size:1.1rem;margin-bottom:4px}\n.skill-chip .sfn{font-weight:600}\n\n.footer{text-align:center;padding:40px 20px;color:#3f3f46;font-size:.72rem;border-top:1px solid rgba(255,255,255,.04);margin-top:40px}\n.footer a{color:var(--cyan);text-decoration:none}\n\n.rv{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}\n.rv.vis{opacity:1;transform:translateY(0)}\n@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}\n\n@media(max-width:768px){\n  .hero{padding:40px 16px 30px}\n  .hero h1{font-size:1.7rem}\n  .kpi-strip{grid-template-columns:repeat(3,1fr)}\n  .kpi .v{font-size:1rem}\n  .file-grid{grid-template-columns:1fr 1fr}\n  .flow-row{gap:4px}\n  .flow-node{min-width:90px;padding:10px 8px}\n  .flow-arrow{font-size:.9rem;padding:0 2px}\n  .tree{font-size:.62rem;line-height:1.8}\n  .stats-box{grid-template-columns:1fr 1fr}\n  .skills-grid{grid-template-columns:repeat(3,1fr)}\n}\n@media(max-width:420px){\n  .kpi-strip{grid-template-columns:1fr 1fr}\n  .file-grid{grid-template-columns:1fr}\n  .skills-grid{grid-template-columns:1fr 1fr}\n}\n</style>\n</head>\n<body>\n\n<div class=\"hero\">\n  <div class=\"hero-badge\">ARCHITECTURE OVERVIEW</div>\n  <h1><span class=\"g\">DropAgentX</span><br>معماری کامل پروژه</h1>\n  <p class=\"sub\">۸۵ فایل Python · ۲۵ فایل JS · ۲۲۷ فایل کل · ۳۸ جدول دیتابیس · ۹۲ تست خودکار</p>\n</div>\n\n<div class=\"kpi-strip rv\">\n  <div class=\"kpi c\"><div class=\"v\">85</div><div class=\"l\">فایل Python</div></div>\n  <div class=\"kpi p\"><div class=\"v\">25</div><div class=\"l\">فایل JavaScript</div></div>\n  <div class=\"kpi g\"><div class=\"v\">227</div><div class=\"l\">فایل کل</div></div>\n  <div class=\"kpi o\"><div class=\"v\">38</div><div class=\"l\">جدول دیتابیس</div></div>\n  <div class=\"kpi pk\"><div class=\"v\">92</div><div class=\"l\">تست خودکار</div></div>\n</div>\n\n<div class=\"wrap\">\n\n<!-- ═══ ARCHITECTURE DIAGRAM ═══ -->\n<div class=\"arch rv\">\n  <h2>🏗️ دیاگرام معماری سیستم</h2>\n  <p class=\"sub-h\">لایه‌های مختلف پروژه از Entry Point تا Database</p>\n\n  <!-- LAYER 1: Entry -->\n  <div class=\"layer l-entry\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">🚀</div>\n      <div><div class=\"layer-title\">Entry Layer — نقطه ورود</div><div class=\"layer-count\">3 files</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">run.py</span><span class=\"fd\">Entry point</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">config.py</span><span class=\"fd\">Pydantic config</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">cron_scheduler.py</span><span class=\"fd\">Task scheduler</span></div>\n    </div>\n  </div>\n\n  <!-- LAYER 2: Core -->\n  <div class=\"layer l-core\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">🧠</div>\n      <div><div class=\"layer-title\">Core Layer — هوش مصنوعی و موتور اصلی</div><div class=\"layer-count\">12 files</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">hermes_engine.py</span><span class=\"fd\">AI Engine</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">ai_agent.py</span><span class=\"fd\">Agent logic</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">tools.py</span><span class=\"fd\">Tool registry</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">identity_rl.py</span><span class=\"fd\">RL identity</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">memory.py</span><span class=\"fd\">Memory store</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">prompt_cache.py</span><span class=\"fd\">Prompt cache</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">token_saver.py</span><span class=\"fd\">Token optimizer</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">moderation.py</span><span class=\"fd\">Content filter</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">approval.py</span><span class=\"fd\">Human approval</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">batch_runner.py</span><span class=\"fd\">Batch tasks</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">fleet.py</span><span class=\"fd\">Multi-bot mgmt</span></div>\n      <div class=\"file\"><span class=\"fi\">🟣</span><span class=\"fn\">i18n.py</span><span class=\"fd\">Internationalization</span></div>\n    </div>\n  </div>\n\n  <!-- LAYER 3: Handlers -->\n  <div class=\"layer l-handler\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">📋</div>\n      <div><div class=\"layer-title\">Handler Layer — مدیریت درخواست‌ها</div><div class=\"layer-count\">17 files · handlers/</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">start.py</span><span class=\"fd\">/onboarding</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">ai_chat.py</span><span class=\"fd\">AI chat</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">marketplace.py</span><span class=\"fd\">marketplace</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">products.py</span><span class=\"fd\">product CRUD</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">wallet.py</span><span class=\"fd\">USDT wallet</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">tasks.py</span><span class=\"fd\">daily tasks</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">support.py</span><span class=\"fd\">support tickets</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">profile.py</span><span class=\"fd\">user profile</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">admin.py</span><span class=\"fd\">admin panel</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">admin_v2.py</span><span class=\"fd\">admin v2</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">referral.py</span><span class=\"fd\">referral system</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">quests.py</span><span class=\"fd\">quests/gamification</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">growth.py</span><span class=\"fd\">growth loops</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">leaderboard.py</span><span class=\"fd\">leaderboard</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">org.py</span><span class=\"fd\">organizations</span></div>\n      <div class=\"file\"><span class=\"fi\">🟢</span><span class=\"fn\">help.py</span><span class=\"fd\">help system</span></div>\n    </div>\n  </div>\n\n  <!-- LAYER 4: Services -->\n  <div class=\"layer l-service\">\n    <div class=\"layer-head\">\n      <div class=\"layer-icon\">⚙️</div>\n      <div><div class=\"layer-title\">Service Layer — سرویس‌ها و یکپارچه‌سازی</div><div class=\"layer-count\">18 files</div></div>\n    </div>\n    <div class=\"file-grid\">\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">database.py</span><span class=\"fd\">SQLite ORM</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">commerce.py</span><span class=\"fd\">commerce engine</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">blockchain.py</span><span class=\"fd\">USDT/TRC20</span></div>\n      <div class=\"file\"><span class=\"fi\">🟡</span><span class=\"fn\">skills.py</span><spa