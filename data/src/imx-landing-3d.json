{"files":[{"path":"README.md","lang":"markdown","size":391,"truncated":false,"content":"# ImXforever — 3D Portfolio Landing (KIA)\n\nلندینگ سه‌بعدی پورتفولیو با هویت ذرات KIA و دموی تعاملی Pyodide.\n\n## Kit\n\n- HTML\n- Three.js\n- Pyodide\n- Google Fonts\n\n## اجرا\n\n```bash\n# مستقیم در مرورگر باز کنید، یا:\npython -m http.server 8000\n```\n\n> تک‌فایل؛ نسل قبلی صفحه اصلی پورتفولیو.\n"},{"path":"index.html","lang":"xml","size":27600,"truncated":false,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>ImXforever — Portfolio</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap');\n\n  :root {\n    --cyan: #22d3ee;\n    --purple: #a78bfa;\n    --green: #34d399;\n    --gold: #fbbf24;\n    --pink: #f472b6;\n    --orange: #fb923c;\n    --bg: #06060e;\n    --surface: rgba(12,12,24,0.85);\n  }\n\n  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    background: var(--bg);\n    color: #e4e4e7;\n    overflow-x: hidden;\n    cursor: default;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  /* ─── Three.js canvas ─── */\n  #bg {\n    position: fixed;\n    inset: 0;\n    z-index: 0;\n    width: 100vw;\n    height: 100vh;\n  }\n\n  /* ─── Scroll container ─── */\n  .scroll-container {\n    position: relative;\n    z-index: 1;\n  }\n\n  /* ─── Sections ─── */\n  section {\n    min-height: 100vh;\n    min-height: 100dvh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 60px 24px;\n    position: relative;\n  }\n\n  /* ─── Hero ─── */\n  .hero { flex-direction: column; text-align: center; }\n\n  .hero-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: clamp(0.65rem, 2vw, 0.85rem);\n    color: var(--cyan);\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    margin-bottom: 20px;\n    opacity: 0;\n    animation: fadeUp 0.8s 0.3s ease forwards;\n  }\n\n  .hero h1 {\n    font-size: clamp(3.5rem, 12vw, 7rem);\n    font-weight: 900;\n    line-height: 1;\n    letter-spacing: -3px;\n    margin-bottom: 20px;\n    opacity: 0;\n    animation: fadeUp 0.8s 0.5s ease forwards;\n  }\n  .hero h1 .gradient {\n    background: linear-gradient(135deg, var(--cyan), var(--purple), var(--pink));\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .hero-sub {\n    font-size: clamp(0.95rem, 2.5vw, 1.2rem);\n    color: #71717a;\n    max-width: 500px;\n    line-height: 1.7;\n    margin-bottom: 40px;\n    opacity: 0;\n    animation: fadeUp 0.8s 0.7s ease forwards;\n    padding: 0 16px;\n  }\n\n  .hero-buttons {\n    display: flex;\n    gap: 16px;\n    flex-wrap: wrap;\n    justify-content: center;\n    opacity: 0;\n    animation: fadeUp 0.8s 0.9s ease forwards;\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    padding: 16px 32px;\n    border-radius: 14px;\n    font-size: 1rem;\n    font-weight: 600;\n    text-decoration: none;\n    transition: all 0.3s cubic-bezier(0.22,1,0.36,1);\n    cursor: pointer;\n    border: none;\n    font-family: 'Inter', sans-serif;\n    will-change: transform;\n  }\n\n  .btn-primary {\n    background: linear-gradient(135deg, var(--cyan), var(--purple));\n    color: #06060e;\n    box-shadow: 0 0 40px rgba(34,211,238,0.25);\n  }\n  .btn-primary:hover, .btn-primary:active {\n    transform: translateY(-3px) scale(1.03);\n    box-shadow: 0 0 60px rgba(34,211,238,0.4);\n  }\n\n  .btn-ghost {\n    background: rgba(255,255,255,0.05);\n    color: #e4e4e7;\n    border: 1px solid rgba(255,255,255,0.1);\n    backdrop-filter: blur(10px);\n  }\n  .btn-ghost:hover, .btn-ghost:active {\n    background: rgba(255,255,255,0.1);\n    transform: translateY(-3px);\n    border-color: var(--cyan);\n  }\n\n  .btn svg { width: 20px; height: 20px; flex-shrink: 0; }\n\n  .scroll-hint {\n    position: absolute;\n    bottom: 40px;\n    left: 50%;\n    transform: translateX(-50%);\n    opacity: 0;\n    animation: fadeUp 0.8s 1.2s ease forwards;\n  }\n  .scroll-hint .mouse {\n    display: block;\n    width: 24px;\n    height: 40px;\n    border: 2px solid rgba(255,255,255,0.2);\n    border-radius: 12px;\n    position: relative;\n    margin: 0 auto 8px;\n  }\n  .scroll-hint .mouse::after {\n    content: '';\n    position: absolute;\n    top: 8px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 4px;\n    height: 10px;\n    background: var(--cyan);\n    border-radius: 2px;\n    animation: scrollDot 1.5s ease infinite;\n  }\n  @keyframes scrollDot {\n    0%,100% { opacity:1; top:8px; }\n    50% { opacity:0.3; top:20px; }\n  }\n\n  /* ─── Stats section ─── */\n  .stats-section { flex-direction: column; gap: 50px; }\n\n  .section-header {\n    text-align: center;\n    margin-bottom: 10px;\n  }\n  .section-header h2 {\n    font-size: clamp(1.6rem, 5vw, 2.5rem);\n    font-weight: 800;\n    letter-spacing: -1px;\n  }\n  .section-header p {\n    color: #71717a;\n    font-size: clamp(0.85rem, 2vw, 1rem);\n    margin-top: 8px;\n  }\n\n  .stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n    width: 100%;\n    max-width: 1000px;\n  }\n\n  .stat-card {\n    background: var(--surface);\n    border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 20px;\n    padding: 28px 16px;\n    text-align: center;\n    backdrop-filter: blur(20px);\n    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;\n  }\n  .stat-card:hover {\n    transform: translateY(-8px);\n    border-color: rgba(34,211,238,0.3);\n    box-shadow: 0 20px 60px rgba(34,211,238,0.1);\n  }\n\n  .stat-card .icon { font-size: 2rem; margin-bottom: 12px; }\n  .stat-card .val {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: clamp(1.5rem, 4vw, 2.2rem);\n    font-weight: 700;\n    line-height: 1;\n    margin-bottom: 6px;\n  }\n  .stat-card .lbl {\n    font-size: 0.75rem;\n    color: #71717a;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n  .stat-card:nth-child(1) .val { color: var(--cyan); }\n  .stat-card:nth-child(2) .val { color: var(--green); }\n  .stat-card:nth-child(3) .val { color: var(--gold); }\n  .stat-card:nth-child(4) .val { color: var(--pink); }\n\n  /* ─── Repo cards ─── */\n  .repos-section { flex-direction: column; gap: 40px; }\n\n  .repos-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));\n    gap: 20px;\n    width: 100%;\n    max-width: 1100px;\n  }\n\n  .repo-card {\n    background: var(--surface);\n    border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 20px;\n    padding: 24px;\n    backdrop-filter: blur(20px);\n    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;\n    position: relative;\n    overflow: hidden;\n  }\n  .repo-card::before {\n    content: '';\n    position: absolute;\n    top: 0; left: 0; right: 0;\n    height: 3px;\n    border-radius: 20px 20px 0 0;\n  }\n  .repo-card:hover {\n    transform: translateY(-6px);\n    box-shadow: 0 20px 50px rgba(0,0,0,0.4);\n    border-color: rgba(34,211,238,0.2);\n  }\n\n  .repo-card[data-tier=\"1\"]::before { background: linear-gradient(90deg, var(--cyan), var(--purple)); }\n  .repo-card[data-tier=\"2\"]::before { background: linear-gradient(90deg, var(--purple), var(--pink)); }\n  .repo-card[data-tier=\"3\"]::before { background: linear-gradient(90deg, var(--gold), var(--orange)); }\n  .repo-card[data-tier=\"4\"]::before { background: linear-gradient(90deg, #52525b, #3f3f46); }\n\n  .repo-card .top {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 8px;\n    margin-bottom: 12px;\n  }\n  .repo-card .name {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 700;\n    font-size: 1rem;\n    color: #fff;\n    word-break: break-all;\n  }\n  .repo-card .tier {\n    font-size: 0.65rem;\n    padding: 4px 10px;\n    border-radius: 20px;\n    font-weight: 600;\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n  .t1 { background: rgba(34,211,238,0.15); color: var(--cyan); }\n  .t2 { background: rgba(167,139,250,0.15); color: var(--purple); }\n  .t3 { background: rgba(251,191,36,0.15); color: var(--gold); }\n  .t4 { background: rgba(113,113,122,0.15); color: #71717a; }\n\n  .repo-card .desc {\n    font-size: 0.82rem;\n    color: #71717a;\n    line-height: 1.5;\n    margin-bottom: 14px;\n  }\n\n  .repo-card .meta {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    font-size: 0.72rem;\n    color: #52525b;\n    margin-bottom: 14px;\n  }\n  .repo-card .meta span { display: inline-flex; align-items: center; gap: 4px; }\n\n  .repo-card .val-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n  .repo-card .val {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 700;\n    font-size: 1rem;\n  }\n  .repo-card .pct {\n    font-size: 0.8rem;\n    color: #71717a;\n  }\n  .repo-card .bar {\n    width: 100%;\n    height: 5px;\n    background: rgba(255,255,255,0.05);\n    border-radius: 3px;\n    margin-top: 10px;\n    overflow: hidden;\n  }\n  .repo-card .bar-fill {\n    height: 100%;\n    border-radius: 3px;\n    width: 0%;\n    transition: width 1.2s cubic-bezier(0.22,1,0.36,1);\n  }\n\n  /* ─── CTA section ─── */\n  .cta-section { text-align: center; }\n  .cta-section h2 {\n    font-size: clamp(2rem, 6vw, 3rem);\n    font-weight: 900;\n    letter-spacing: -1px;\n    margin-bottom: 16px;\n  }\n  .cta-section p {\n    color: #71717a;\n    font-size: clamp(0.95rem, 2.5vw, 1.1rem);\n    margin-bottom: 40px;\n    max-width: 500px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .cta-glow {\n    position: relative;\n    display: inline-block;\n  }\n  .cta-glow::before {\n    content: '';\n    position: absolute;\n    inset: -4px;\n    border-radius: 18px;\n    background: linear-gradient(135deg, var(--cyan), var(--purple), var(--pink));\n    filter: blur(20px);\n    opacity: 0.4;\n    z-index: -1;\n    animation: glow 3s ease infinite alternate;\n  }\n  @keyframes glow {\n    0% { opacity: 0.3; filter: blur(20px); }\n    100% { opacity: 0.6; filter: blur(30px); }\n  }\n\n  /* ─── Footer ─── */\n  .footer {\n    position: relative;\n    z-index: 1;\n    text-align: center;\n    padding: 40px 24px;\n    color: #3f3f46;\n    font-size: 0.8rem;\n    border-top: 1px solid rgba(255,255,255,0.04);\n  }\n\n  /* ─── Animations ─── */\n  @keyframes fadeUp {\n    from { opacity:0; transform:translateY(30px); }\n    to { opacity:1; transform:translateY(0); }\n  }\n\n  .reveal {\n    opacity: 0;\n    transform: translateY(40px);\n    transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1);\n  }\n  .reveal.visible {\n    opacity: 1;\n    transform: translateY(0);\n  }\n\n  /* ─── Reduced motion ─── */\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n      animation-duration: 0.01ms !important;\n      transition-duration: 0.01ms !important;\n    }\n    .reveal { opacity: 1; transform: none; }\n  }\n\n  /* ─── Responsive ─── */\n  @media (max-width: 768px) {\n    section { padding: 40px 16px; }\n    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n    .stat-card { padding: 20px 12px; }\n    .repos-grid { grid-template-columns: 1fr; }\n    .hero-buttons { flex-direction: column; align-items: center; }\n    .hero-buttons .btn { width: 100%; max-width: 300px; justify-content: center; }\n    .hero h1 { letter-spacing: -1px; }\n    .scroll-hint { bottom: 20px; }\n  }\n\n  @media (max-width: 400px) {\n    .stats-grid { grid-template-columns: 1fr 1fr; gap: 8px; }\n    .stat-card { padding: 16px 10px; }\n    .stat-card .icon { font-size: 1.5rem; }\n    .repo-card { padding: 18px; }\n  }\n\n  @media (min-width: 1400px) {\n    .repos-grid { grid-template-columns: repeat(3, 1fr); }\n  }\n</style>\n</head>\n<body>\n\n<canvas id=\"bg\"></canvas>\n\n<div class=\"scroll-container\">\n\n  <!-- ═══════ HERO ═══════ -->\n  <section class=\"hero\">\n    <div class=\"hero-tag\">RL Engineer · Builder · Trader</div>\n    <h1><span class=\"gradient\">KIA</span></h1>\n    <p class=\"hero-sub\">\n      Building AI agents, trading bots, and social commerce —\n      one first-principle at a time.\n    </p>\n    <div class=\"hero-buttons\">\n      <a href=\"https://github.com/ImXforever\" target=\"_blank\" rel=\"noopener\" class=\"btn btn-primary\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z\"/></svg>\n        View on GitHub\n      </a>\n      <a href=\"#stats\" class=\"btn btn-ghost\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n        See Portfolio\n      </a>\n    </div>\n    <div class=\"scroll-hint\" aria-hidden=\"true\">\n      <span class=\"mouse\"></span>\n      <div style=\"font-size:0.7rem;color:#52525b\">scroll</div>\n    </div>\n  </section>\n\n  <!-- ═══════ STATS ═══════ -->\n  <section class=\"stats-section\" id=\"stats\">\n    <div class=\"section-header reveal\">\n      <h2>Portfolio at a Glance</h2>\n      <p>$19K — $38K estimated across 34 repositories</p>\n    </div>\n    <div class=\"stats-grid\">\n      <div class=\"stat-card reveal\">\n        <div class=\"icon\">📦</div>\n        <div class=\"val\">34</div>\n        <div class=\"lbl\">Repositories</div>\n      </div>\n      <div class=\"stat-card reveal\">\n        <div class=\"icon\">💎</div>\n        <div class=\"val\">$29K</div>\n        <div class=\"lbl\">Total Value</div>\n      </div>\n      <div class=\"stat-card reveal\">\n        <div class=\"icon\">🧠</div>\n        <div class=\"val\">4</div>\n        <div class=\"lbl\">RL Projects</div>\n      </div>\n      <div class=\"stat-card reveal\">\n        <div class=\"icon\">👥</div>\n        <div class=\"val\">308</div>\n        <div class=\"lbl\">Active Users</div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ═══════ REPOS ═══════ -->\n  <section class=\"repos-section\" id=\"repos\">\n    <div class=\"section-header reveal\">\n      <h2>Top Repositories</h2>\n      <p>Ranked by estimated dollar value</p>\n    </div>\n    <div class=\"repos-grid\" id=\"reposGrid\"></div>\n  </section>\n\n  <!-- ═══════ CTA ═══════ -->\n  <section class=\"cta-section\">\n    <div class=\"reveal\">\n      <h2>Let's Build.</h2>\n      <p>Open source. First principles. Zero fluff.</p>\n      <div class=\"cta-glow\">\n        <a href=\"https://github.com/ImXforever\" target=\"_blank\" rel=\"noopener\" class=\"btn btn-primary\" style=\"font-size:1.1rem;padding:20px 48px;\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"width:24px;height:24px\"><path d=\"M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z\"/></svg>\n          github.com/ImXforever\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"footer\">\n    ImXforever · KIA · Built with first principles\n  </div>\n\n</div>\n\n<!-- ═══════ THREE.JS ═══════ -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script>\n(function() {\n  'use strict';\n\n  // ─── Device detection ───\n  const isMobile = /Android|iPhone|iPad|iPod|Opera Mini|IEMobile/i.test(navigator.userAgent)\n                   || window.innerWidth < 768;\n  const isLowEnd = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4;\n  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  // ─── Adaptive particle count ───\n  const COUNT = prefersReducedMotion ? 0 : (isMobile ? 300 : isLowEnd ? 500 : 1000);\n  const PIXEL_RATIO = Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2);\n\n  // ─── Three.js setup ───\n  const canvas = document.getElementById('bg');\n  const renderer = new THREE.WebGLRenderer({ canvas, antialias: !isMobile, alpha: true });\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  renderer.setPixelRatio(PIXEL_RATIO);\n\n  const scene = new THREE.Scene();\n  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n  camera.position.set(0, 0, 30);\n\n  let sceneGroup;\n  let particleGeo = null;\n  let initialPositions = null;\n\n  if (COUNT > 0) {\n    sceneGroup = new THREE.Group();\n    scene.add(sceneGroup);\n\n    // ─── Particles ───\n    particleGeo = new THREE.BufferGeometry();\n    const positions = new Float32Array(COUNT * 3);\n    const colors = new Float32Array(COUNT * 3);\n    const palette = [\n      [0.133, 0.827, 0.933],\n      [0.655, 0.545, 0.980],\n      [0.204, 0.827, 0.600],\n      [0.984, 0.745, 0.141],\n    ];\n\n    for (let i = 0; i < COUNT; i++) {\n      const i3 = i * 3;\n      positions[i3]     = (Math.random() - 0.5) * 80;\n      positions[i3 + 1] = (Math.random() - 0.5) * 80;\n      positions[i3 + 2] = (Math.random() - 0.5) * 60;\n      const c = palette[Math.floor(Math.random() * palette.length)];\n      colors[i3]     = c[0];\n      colors[i3 + 1] = c[1];\n      colors[i3 + 2] = c[2];\n    }\n\n    // Store base positions for wave animation (no drift)\n    initialPositions = new Float32Array(positions);\n\n    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));\n    particleGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));\n\n    const mat = new THREE.PointsMaterial({\n      size: isMobile ? 0.2 : 0.15,\n      vertexColors: true,\n      transparent: true,\n      opacity: 0.7,\n      blending: THREE.AdditiveBlending,\n      depthWrite: false,\n    });\n\n    sceneGroup.add(new THREE.Points(particleGeo, mat));\n\n    // ─── Grid plane ───\n    const gridGeo = new THREE.PlaneGeometry(100, 100, isMobile ? 20 : 40, isMobile ? 20 : 40);\n    const gridMat = new THREE.MeshBasicMaterial({\n      color: 0x22d3ee,\n      wireframe: true,\n      transparent: true,\n      opacity: 0.04,\n    });\n    const gridMesh = new THREE.Mesh(gridGeo, gridMat);\n    gridMesh.rotation.x = -Math.PI / 2;\n    gridMesh.position.y = -15;\n    sceneGroup.add(gridMesh);\n\n    // ─── Floating rings (reduced on mobile) ───\n    const ringCount = isMobile ? 2 : 3;\n    const rings = [];\n    for (let i = 0; i < ringCount; i++) {\n      const ringGeo = new THREE.TorusGeometry(6 + i * 4, 0.05, 8, isMobile ? 32 : 64);\n      const ringMat = new THREE.MeshBasicMaterial({\n        color: [0x22d3ee, 0xa78bfa, 0x34d399][i],\n        transparent: true,\n        opacity: 0.12,\n      });\n      const ring = new THREE.Mesh(ringGeo, ringMat);\n      ring.position.y = -8 + i * 2;\n      ring.rotation.x = Math.PI / 3 + i * 0.2;\n      ring.userData = { speed: 0.001 + i * 0.0005, baseY: -8 + i * 2, axis: i };\n      sceneGroup.add(ring);\n      rings.push(ring);\n    }\n\n    // Expose for animate\n    window._rings = rings;\n  }\n\n  // ─── Mouse / Touch tracking ───\n  let mx = 0, my = 0;\n  let targetMx = 0, targetMy = 0;\n\n  document.addEventListener('mousemove', function(e) {\n    targetMx = (e.clientX / window.innerWidth - 0.5) * 2;\n    targetMy = (e.clientY / window.innerHeight - 0.5) * 2;\n  });\n\n  // Touch support for parallax on mobile\n  document.addEventListener('touchmove', function(e) {\n    if (e.touches.length === 1) {\n      targetMx = (e.touches[0].clientX / window.innerWidth - 0.5) * 2;\n      targetMy = (e.touches[0].clientY / window.innerHeight - 0.5) * 2;\n    }\n  }, { passive: true });\n\n  document.addEventListener('touchend', function() {\n    targetMx = 0;\n    targetMy = 0;\n  }, { passive: true });\n\n  // ─── Scroll tracking ───\n  let scrollY = 0;\n  let targetScrollY = 0;\n  window.addEventListener('scroll', function() {\n    targetScrollY = window.scrollY;\n  }, { passive: true });\n\n  // ─── Animation loop ───\n  const clock = new THREE.Clock();\n\n  function animate() {\n    requestAnimationFrame(animate);\n\n    // Skip rendering when tab is hidden\n    if (document.hidden) return;\n\n    const elapsed = clock.getElapsedTime();\n\n    // Smooth interpolation (lerp) for mouse & scroll\n    mx += (targetMx - mx) * 0.05;\n    my += (targetMy - my) * 0.05;\n    scrollY += (targetScrollY - scrollY) * 0.08;\n\n    if (sceneGroup && COUNT > 0) {\n      // Rotate particles — use base rotation + mouse offset\n      sceneGroup.rotation.y = elapsed * 0.05 + mx * 0.15;\n      sceneGroup.rotation.x = my * 0.08;\n      sceneGroup.position.y = -scrollY * 0.003;\n\n      // Wave particles — from initial positions (NO drift)\n      if (particleGeo && initialPositions) {\n        const pos = particleGeo.attributes.position.array;\n        for (let i = 0; i < COUNT; i++) {\n          const i3 = i * 3;\n          pos[i3 + 1] = initialPositions[i3 + 1] + Math.sin(elapsed + initialPositions[i3] * 0.1) * 1.5;\n        }\n        particleGeo.attributes.position.needsUpdate = true;\n      }\n\n      // Float rings — oscillate around baseY (NO drift)\n      if (window._rings) {\n        window._rings.forEach(function(ring) {\n          ring.rotation.z = elapsed * ring.userData.speed * 60;\n          ring.position.y = ring.userData.baseY + Math.sin(elapsed * 0.5 + ring.userData.axis) * 1.5;\n        });\n      }\n    }\n\n    // Camera parallax\n    camera.position.x += (mx * 2 - camera.position.x) * 0.02;\n    camera.position.y += (-my * 2 - camera.position.y) * 0.02;\n    camera.lookAt(0, -scrollY * 0.003, 0);\n\n    renderer.render(scene, camera);\n  }\n\n  if (!prefersReducedMotion) {\n    animate();\n  } else {\n    // Static render for reduced-motion\n    renderer.render(scene, camera);\n  }\n\n  // ─── Resize handler (debounced) ───\n  let resizeTimer;\n  window.addEventListener('resize', function() {\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(function() {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n    }, 150);\n  });\n\n  // ─── Tab visibility — pause when hidden ───\n  document.addEventListener('visibilitychange', function() {\n    if (!document.hidden && !prefersReducedMotion) {\n      clock.start();\n    }\n  });\n\n  // ─── Scroll Reveal (live — catches dynamically added elements) ───\n  const revealObserver = new IntersectionObserver(function(entries) {\n    entries.forEach(function(entry) {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('visible');\n        // Animate bar fills\n        entry.target.querySelectorAll('.bar-fill').forEach(function(bar) {\n          setTimeout(function() { bar.style.width = bar.dataset.w; }, 200);\n        });\n        revealObserver.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });\n\n  // ─── Repo Cards ───\n  var reposData = [\n    { name:\"DropAgentXBot\", lang:\"Python\", tier:1, lo:8000, hi:15000, desc:\"Social commerce Telegram bot with AI agent, multi-faceted memory, identity RL, USDT treasury, A2A/MCP\", users:\"308\", tags:[\"AI\",\"Marketplace\",\"USDT\"] },\n    { name:\"DropAgentXmain\", lang:\"Python\", tier:1, lo:3000, hi:5000, desc:\"Monorepo — Docker, FastAPI, Next.js, 12 topics, full production stack\", users:\"—\", tags:[\"Monorepo\",\"Docker\",\"FastAPI\"] },\n    { name:\"GQR-v1\", lang:\"Python\", tier:2, lo:2000, hi:4000, desc:\"Transformer Actor-Critic, PPO trainer, SMC engine, DXY-Nexus cross-asset fusion, model guard rollback\", users:\"—\", tags:[\"RL\",\"Trading\",\"PyTorch\"] },\n    { name:\"GQR-v2\", lang:\"TypeScript\", tier:2, lo:1500, hi:3000, desc:\"1166 lines of technical indicators + 420 lines of codebase analysis engine\", users:\"—\", tags:[\"Indicators\",\"TypeScript\"] },\n    { name:\"GQR-v3\", lang:\"TypeScript\", tier:2, lo:1000, hi:2000, desc:\"Third iteration of the quantitative trading system\", users:\"—\", tags:[\"RL\",\"Quant\"] },\n    { name:\"solmarket\", lang:\"TypeScript\", tier:2, lo:800, hi:1500, desc:\"SOL + USDC marketplace on Solana\", users:\"—\", tags:[\"Solana\",\"DeFi\"] },\n    { name:\"DOGE\", lang:\"HTML\", tier:1, lo:500, hi:1000, desc:\"9 Dogecoin dashboards — easy to legendary\", users:\"—\", tags:[\"Crypto\",\"Dashboard\"] },\n    { name:\"Pyhub\", lang:\"HTML\", tier:1, lo:300, hi:600, desc:\"Python reference + interactive workshop with Pyodide, PWA, gamification\", users:\"—\", tags:[\"Python\",\"PWA\"] },\n    { name:\"Neon-Prompt-Studio\", lang:\"HTML\", tier:3, lo:200, hi:400, desc:\"Neon Prompt Studio Ultimate\", users:\"—\", tags:[\"AI\",\"Prompts\"] },\n    { name:\"X\", lang:\"HTML\", tier:3, lo:300, hi:600, desc:\"MT5 Fetcher — MetaTrader data pipeline\", users:\"—\", tags:[\"Trading\",\"MT5\"] },\n    { name:\"senpai-bot\", lang:\"JavaScript\", tier:3, lo:200, hi:400, desc:\"Telegram bot\", users:\"—\", tags:[\"Bot\",\"Telegram\"] },\n    { name:\"0xElon\", lang:\"Python\", tier:3, lo:200, hi:400, desc:\"HermesBOT\", users:\"—\", tags:[\"AI\",\"Bot\"] },\n  ];\n\n  var totalMid = 29025;\n  var reposGrid = document.getElementById('reposGrid');\n  var tierLabels = ['', '\\u{1F525} Core', '\\u{1F9E0} RL', '\\u{1F6E0}\\uFE0F Tool', '\\u{1F4E6} Proto'];\n\n  var fragment = document.createDocumentFragment();\n\n  reposData.forEach(function(r, i) {\n    var mid = Math.round((r.lo + r.hi) / 2);\n    var pct = (mid / totalMid * 100).toFixed(1);\n    var valColor = r.tier === 1 ? 'var(--cyan)' : r.tier === 2 ? 'var(--purple)' : r.tier === 3 ? 'var(--gold)' : '#71717a';\n    var gradient = r.tier === 1 ? 'var(--cyan),var(--purple)' :\n                   r.tier === 2 ? 'var(--purple),var(--pink)' :\n                   r.tier === 3 ? 'var(--gold),var(--orange)' : '#52525b,#3f3f46';\n\n    var card = document.createElement('div');\n    card.className = 'repo-card reveal';\n    card.setAttribute('data-tier', r.tier);\n    card.innerHTML =\n      '<div class=\"top\">' +\n        '<div class=\"name\">' + r.name + '</div>' +\n        '<div class=\"tier t' + r.tier + '\">' + tierLabels[r.tier] + '</div>' +\n      '</div>' +\n      '<div class=\"desc\">' + r.desc + '</div>' +\n      '<div class=\"meta\">' +\n        '<span>\\u{1F535} ' + r.lang + '</span>' +\n        (r.users !== '\\u2014' ? '<span>\\u{1F465} ' + r.users + ' users</span>' : '') +\n        r.tags.map(function(t) { return '<span>#' + t + '</span>'; }).join('') +\n      '</div>' +\n      '<div class=\"val-row\">' +\n        '<div class=\"val\" style=\"color:' + valColor + '\">$' + r.lo.toLocaleString() + ' \\u2014 $' + r.hi.toLocaleString() + '</div>' +\n        '<div class=\"pct\">' + pct + '%</div>' +\n      '</div>' +\n      '<div class=\"bar\"><div class=\"bar-fill\" data-w=\"' + pct + '%\" style=\"background:linear-gradient(90deg,' + gradient + ')\"></div></div>';\n\n    fragment.appendChild(card);\n  });\n\n  reposGrid.appendChild(fragment);\n\n  // ─── Observe all .reveal elements (including dynamically added) ───\n  document.querySelectorAll('.reveal').forEach(function(el) {\n    revealObserver.observe(el);\n  });\n\n})();\n</script>\n\n</body>\n</html>\n"}]}