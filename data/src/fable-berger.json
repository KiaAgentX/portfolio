{"files":[{"path":"README.md","lang":"markdown","size":425,"truncated":false,"content":"# 🍔 برگرساز سه‌بعدی — Fable Berger\n\nابزار تعاملی چیدن برگر با مواد مختلف در یک صحنه سه‌بعدی زنده (Three.js).\n\n## Kit\n\n- HTML\n- Three.js\n- Google Fonts\n\n## اجرا\n\n```bash\n# مستقیم در مرورگر باز کنید، یا:\npython -m http.server 8000\n```\n\n> تک‌فایل؛ اجرا با باز کردن مستقیم index.html در مرورگر.\n"},{"path":"index.html","lang":"xml","size":34302,"truncated":false,"content":"<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<title>برگرساز سه‌بعدی</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg1:#1a0f0a; --bg2:#3b1d0e; --accent:#ffb02e; --accent2:#ff6a3d;\n    --panel:rgba(20,12,8,.72); --line:rgba(255,255,255,.09); --text:#fff4e6; --muted:#c9a98a;\n  }\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\n  html,body{margin:0;height:100%;overflow:hidden;background:var(--bg1);color:var(--text);\n    font-family:'Vazirmatn',Tahoma,system-ui,sans-serif;}\n  #bg{position:fixed;inset:0;z-index:0;\n    background:\n      radial-gradient(60% 55% at 50% 40%, #6b3418 0%, rgba(107,52,24,0) 70%),\n      radial-gradient(90% 90% at 80% 100%, #2c1508 0%, rgba(44,21,8,0) 60%),\n      linear-gradient(180deg,var(--bg2) 0%,var(--bg1) 100%);}\n  #bg::after{content:\"\";position:absolute;inset:0;opacity:.25;mix-blend-mode:overlay;\n    background-image:radial-gradient(rgba(255,255,255,.35) 1px,transparent 1px);background-size:3px 3px;}\n  #c{position:fixed;inset:0;z-index:1;display:block;width:100%;height:100%;touch-action:none;cursor:grab}\n  #c.grabbing{cursor:grabbing}\n\n  #ui{position:fixed;top:0;right:0;bottom:0;z-index:3;width:min(340px,100%);padding:18px 16px;\n    background:var(--panel);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);\n    border-left:1px solid var(--line);display:flex;flex-direction:column;gap:14px;overflow:auto;\n    scrollbar-width:thin;}\n  h1{margin:0;font-size:22px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:8px}\n  h1 span{color:var(--accent)}\n  .sub{margin:0;font-size:12px;color:var(--muted)}\n  .card{border:1px solid var(--line);border-radius:14px;padding:12px;background:rgba(255,255,255,.03)}\n  .card h2{margin:0 0 10px;font-size:13px;font-weight:600;color:var(--muted);display:flex;justify-content:space-between;align-items:center}\n  .row{display:flex;gap:8px;align-items:center}\n  button{font-family:inherit;color:var(--text);background:rgba(255,255,255,.06);border:1px solid var(--line);\n    border-radius:10px;padding:9px 10px;font-size:13px;cursor:pointer;transition:transform .12s,background .15s,border-color .15s}\n  button:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.2)}\n  button:active{transform:scale(.96)}\n  button.primary{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#241006;font-weight:800;border:none;flex:1;font-size:14px}\n  button.primary:hover{filter:brightness(1.08)}\n  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}\n  .grid button{display:flex;flex-direction:column;align-items:center;gap:3px;padding:8px 4px;font-size:12px}\n  .grid button b{font-size:20px;font-weight:400;line-height:1}\n  input[type=range]{width:100%;accent-color:var(--accent);cursor:pointer}\n  #layers{display:flex;flex-direction:column;gap:6px;min-height:40px}\n  .layer{display:flex;align-items:center;gap:6px;padding:7px 8px;border-radius:10px;background:rgba(255,255,255,.05);\n    border:1px solid var(--line);animation:pop .25s ease-out;font-size:13px}\n  @keyframes pop{from{transform:translateY(-6px);opacity:0}to{transform:none;opacity:1}}\n  .layer .nm{flex:1;display:flex;align-items:center;gap:7px}\n  .layer .nm i{font-style:normal;font-size:16px}\n  .layer button{padding:4px 7px;font-size:12px;border-radius:7px;line-height:1}\n  .layer button:disabled{opacity:.3;cursor:default;transform:none}\n  .layer button.del{color:#ff8d7a}\n  .stat{display:flex;justify-content:space-between;font-size:13px;padding:2px 2px}\n  .stat b{color:var(--accent);font-weight:800}\n  .empty{font-size:12px;color:var(--muted);text-align:center;padding:10px 0}\n  .presets{display:flex;gap:6px;flex-wrap:wrap}\n  .presets button{flex:1;font-size:12px;padding:7px 6px}\n\n  #hint{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:2;font-size:13px;color:var(--muted);\n    background:rgba(0,0,0,.35);padding:8px 14px;border-radius:999px;border:1px solid var(--line);\n    backdrop-filter:blur(8px);white-space:nowrap;pointer-events:none;transition:opacity .5s}\n  #hint.hide{opacity:0}\n  #err{position:fixed;inset:0;z-index:10;display:none;align-items:center;justify-content:center;padding:30px;text-align:center;background:var(--bg1);font-size:16px;line-height:1.9}\n  #toggleUi{display:none;position:fixed;top:12px;right:12px;z-index:4;border-radius:999px;padding:8px 12px;background:rgba(0,0,0,.45);backdrop-filter:blur(8px)}\n\n  @media (max-width:760px){\n    #ui{top:auto;left:0;right:0;width:100%;max-height:46vh;border-left:none;border-top:1px solid var(--line);\n      border-radius:22px 22px 0 0;padding:14px 14px 20px;transition:transform .3s}\n    #ui.collapsed{transform:translateY(calc(100% - 52px))}\n    #toggleUi{display:block}\n    h1{font-size:18px}\n    #hint{bottom:auto;top:14px;left:14px;transform:none;font-size:12px}\n    .grid{grid-template-columns:repeat(4,1fr)}\n  }\n</style>\n</head>\n<body>\n<div id=\"bg\"></div>\n<canvas id=\"c\"></canvas>\n<div id=\"hint\">🖱️ برای مونتاژ اسکرول کنید · برای چرخش بکشید</div>\n<button id=\"toggleUi\" aria-label=\"پنل\">☰ ساخت برگر</button>\n\n<aside id=\"ui\">\n  <div>\n    <h1>🍔 برگرساز <span>سه‌بعدی</span></h1>\n    <p class=\"sub\">لایه‌ها را اضافه، حذف یا جابه‌جا کنید و برگر خود را زنده ببینید</p>\n  </div>\n\n  <div class=\"card\">\n    <h2>مونتاژ برگر <span id=\"asmPct\">۰٪</span></h2>\n    <input id=\"asm\" type=\"range\" min=\"0\" max=\"1000\" value=\"0\" aria-label=\"میزان مونتاژ\">\n    <div class=\"row\" style=\"margin-top:8px\">\n      <button class=\"primary\" id=\"btnAssemble\">▼ مونتاژ کن</button>\n      <button id=\"btnExplode\" title=\"حالت شناور\">✦ شناور</button>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h2>افزودن لایه</h2>\n    <div class=\"grid\" id=\"addGrid\"></div>\n  </div>\n\n  <div class=\"card\">\n    <h2>لایه‌های برگر <span id=\"layerCount\"></span></h2>\n    <div id=\"layers\"></div>\n    <div class=\"row\" style=\"margin-top:10px\">\n      <div class=\"stat\" style=\"flex:1\"><span>قیمت تقریبی</span><b id=\"price\">۰ تومان</b></div>\n      <button id=\"btnClear\" title=\"حذف همه\" style=\"color:#ff8d7a\">🗑</button>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <h2>پیشنهاد سرآشپز</h2>\n    <div class=\"presets\">\n      <button data-preset=\"classic\">کلاسیک</button>\n      <button data-preset=\"double\">دبل چیز</button>\n      <button data-preset=\"veggie\">گیاهی</button>\n      <button data-preset=\"tower\">برج بیکن</button>\n    </div>\n  </div>\n</aside>\n\n<div id=\"err\">متأسفانه مرورگر شما از WebGL پشتیبانی نمی‌کند یا آن را غیرفعال کرده است.<br>لطفاً با مرورگر به‌روز (Chrome / Firefox / Safari) دوباره امتحان کنید.</div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script>\n(function(){\n'use strict';\n/* ───────────────────────── helpers ───────────────────────── */\nconst $ = s => document.querySelector(s);\nconst fa = n => String(n).replace(/\\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);\nconst clamp = (v,a,b) => v<a?a:v>b?b:v;\nconst lerp = (a,b,t) => a+(b-a)*t;\n\n/* seeded RNG so textures look the same every load */\nlet seed = 1337;\nconst rnd = () => { seed = (seed*1664525 + 1013904223) >>> 0; return seed/4294967296; };\n\n/* value-noise + fbm on a small lattice */\nconst LAT = 64, lattice = new Float32Array(LAT*LAT);\nfor (let i=0;i<lattice.length;i++) lattice[i]=rnd();\nfunction vnoise(x,y){\n  const xi=Math.floor(x), yi=Math.floor(y), xf=x-xi, yf=y-yi;\n  const sx=xf*xf*(3-2*xf), sy=yf*yf*(3-2*yf);\n  const g=(a,b)=>lattice[((b%LAT+LAT)%LAT)*LAT + ((a%LAT+LAT)%LAT)];\n  return lerp(lerp(g(xi,yi),g(xi+1,yi),sx), lerp(g(xi,yi+1),g(xi+1,yi+1),sx), sy);\n}\nfunction fbm(x,y,oct){ let v=0,a=.5,f=1,n=0; for(let i=0;i<(oct||4);i++){ v+=vnoise(x*f,y*f)*a; n+=a; a*=.5; f*=2.1;} return v/n; }\n\n/* canvas texture factory */\nfunction makeTex(size, painter, opts){\n  const cv=document.createElement('canvas'); cv.width=cv.height=size;\n  const ctx=cv.getContext('2d');\n  painter(ctx,size);\n  const t=new THREE.CanvasTexture(cv);\n  t.wrapS=t.wrapT=THREE.RepeatWrapping; t.anisotropy=4;\n  if(opts&&opts.srgb) t.encoding=THREE.sRGBEncoding;\n  if(opts&&opts.repeat){ t.repeat.set(opts.repeat,opts.repeat); }\n  return t;\n}\n/* per-pixel painter: fn(u,v,x,y) -> [r,g,b] */\nfunction pixelPaint(ctx,size,fn){\n  const img=ctx.createImageData(size,size), d=img.data;\n  for(let y=0;y<size;y++)for(let x=0;x<size;x++){\n    const c=fn(x/size,y/size,x,y), i=(y*size+x)*4;\n    d[i]=c[0]; d[i+1]=c[1]; d[i+2]=c[2]; d[i+3]=255;\n  }\n  ctx.putImageData(img,0,0);\n}\n\n/* ───────────────────────── procedural materials ───────────────────────── */\nconst TEX = {};\nfunction buildTextures(){\n  const S=256;\n  /* ---- bun: color / bump / roughness with sesame seeds ---- */\n  const seeds=[]; for(let i=0;i<110;i++) seeds.push({x:rnd(),y:rnd()*.72,r:rnd()*Math.PI,s:.55+rnd()*.5});\n  const drawSeeds=(ctx,size,fill,shade)=>{\n    seeds.forEach(s=>{ ctx.save(); ctx.translate(s.x*size,s.y*size); ctx.rotate(s.r); ctx.scale(s.s,s.s);\n      if(shade){ const g=ctx.createRadialGradient(-2,-2,1,0,0,9); g.addColorStop(0,shade[0]); g.addColorStop(1,shade[1]); ctx.fillStyle=g; } else ctx.fillStyle=fill;\n      ctx.beginPath(); ctx.ellipse(0,0,9,5.2,0,0,Math.PI*2); ctx.fill(); ctx.restore(); });\n  };\n  TEX.bunMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*9,v*9,4), m=fbm(u*40,v*40,2);\n      const t=.55+n*.5, dark=v>.62?lerp(1,.86,(v-.62)/.38):1;   // lighter rim near the bottom edge\n      return [ (205+40*t-25*m)*dark, (128+40*t-30*m)*dark, (55+30*t-20*m)*dark ]; });\n    drawSeeds(ctx,size,null,['#fff4d0','#d9b77a']);\n  },{srgb:true});\n  TEX.bunBump=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*30,v*30,3), g=110+n*40; return [g,g,g]; });\n    drawSeeds(ctx,size,null,['#ffffff','#a0a0a0']);\n  });\n  TEX.bunRough=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*20,v*20,3), g=170+n*60; return [g,g,g]; });\n    drawSeeds(ctx,size,'#5a5a5a');\n  });\n  TEX.bunBottomMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*9+3,v*9,4), m=fbm(u*40,v*40+5,2); const t=.5+n*.5;\n      return [ 200+40*t-25*m, 125+38*t-30*m, 52+28*t-20*m ]; });\n  },{srgb:true});\n  TEX.bunBottomBump=makeTex(S,(ctx,size)=>{ pixelPaint(ctx,size,(u,v)=>{ const g=110+fbm(u*30+7,v*30,3)*40; return [g,g,g]; }); });\n\n  /* ---- patty: charred grain ---- */\n  TEX.pattyMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*14,v*14,5), m=fbm(u*60,v*60,2), c=fbm(u*5+9,v*5,3);\n      const char=c>.62?(c-.62)*2.4:0;                      // dark charred patches\n      const base=.35+n*.55;\n      return [ (95*base+40*m)*(1-char)+18*char, (52*base+22*m)*(1-char)+9*char, (30*base+10*m)*(1-char)+5*char ]; });\n    /* grill scores */\n    ctx.globalAlpha=.55; ctx.strokeStyle='#1c0b04'; ctx.lineWidth=7; ctx.lineCap='round';\n    for(let i=0;i<5;i++){ ctx.beginPath(); ctx.moveTo(0, i*size/5+20); ctx.lineTo(size, i*size/5+20); ctx.stroke(); }\n    ctx.globalAlpha=1;\n  },{srgb:true});\n  TEX.pattyBump=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*45,v*45,4), m=fbm(u*12,v*12,3); const g=90+n*90+m*40; return [g,g,g]; });\n    ctx.strokeStyle='#202020'; ctx.lineWidth=7; ctx.lineCap='round';\n    for(let i=0;i<5;i++){ ctx.beginPath(); ctx.moveTo(0, i*size/5+20); ctx.lineTo(size, i*size/5+20); ctx.stroke(); }\n  });\n  TEX.pattyRough=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*18,v*18,3), grease=fbm(u*7+2,v*7,2); const g=grease>.58?95:(165+n*70); return [g,g,g]; });\n  });\n\n  /* ---- cheese: bubbles + slick sheen ---- */\n  TEX.cheeseMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*8,v*8,3); return [ 248-10*n, 178-45*n, 30+20*n ]; });\n    for(let i=0;i<45;i++){ const x=rnd()*size,y=rnd()*size,r=3+rnd()*7; const g=ctx.createRadialGradient(x,y,0,x,y,r); g.addColorStop(0,'rgba(255,220,120,.0)'); g.addColorStop(.8,'rgba(215,120,20,.35)'); g.addColorStop(1,'rgba(215,120,20,0)'); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fill(); }\n  },{srgb:true});\n  TEX.cheeseBump=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const g=120+fbm(u*10,v*10,3)*30; return [g,g,g]; });\n    seed=99; for(let i=0;i<45;i++){ const x=rnd()*size,y=rnd()*size,r=3+rnd()*7; const g=ctx.createRadialGradient(x,y,0,x,y,r); g.addColorStop(0,'#ffffff'); g.addColorStop(.7,'#c8c8c8'); g.addColorStop(1,'rgba(120,120,120,0)'); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fill(); }\n  });\n  TEX.cheeseRough=makeTex(S,(ctx,size)=>{ pixelPaint(ctx,size,(u,v)=>{ const g=60+fbm(u*12,v*12,3)*90; return [g,g,g]; }); });\n\n  /* ---- tomato slice cap ---- */\n  TEX.tomatoTop=makeTex(S,(ctx,size)=>{\n    const c=size/2;\n    let g=ctx.createRadialGradient(c,c,0,c,c,c); g.addColorStop(0,'#ffb8a0'); g.addColorStop(.35,'#ff7a5c'); g.addColorStop(.72,'#e8402a'); g.addColorStop(.9,'#c9241a'); g.addColorStop(1,'#a51410');\n    ctx.fillStyle=g; ctx.fillRect(0,0,size,size);\n    /* seed chambers */\n    for(let k=0;k<6;k++){ const a=k*Math.PI/3+.4; ctx.save(); ctx.translate(c+Math.cos(a)*size*.27, c+Math.sin(a)*size*.27); ctx.rotate(a);\n      const jg=ctx.createRadialGradient(0,0,2,0,0,size*.12); jg.addColorStop(0,'rgba(255,190,150,.9)'); jg.addColorStop(1,'rgba(230,80,50,.2)');\n      ctx.fillStyle=jg; ctx.beginPath(); ctx.ellipse(0,0,size*.13,size*.08,0,0,7); ctx.fill();\n      ctx.fillStyle='#f6e9a8'; for(let s=0;s<6;s++){ ctx.beginPath(); ctx.ellipse((s-2.5)*size*.035,(s%2?1:-1)*size*.02,size*.017,size*.01,.6,0,7); ctx.fill(); }\n      ctx.restore(); }\n    ctx.strokeStyle='rgba(255,200,180,.55)'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(c,c,size*.44,0,7); ctx.stroke();\n  },{srgb:true});\n  TEX.tomatoRough=makeTex(S,(ctx,size)=>{ pixelPaint(ctx,size,(u,v)=>{ const g=60+fbm(u*10,v*10,2)*60; return [g,g,g]; }); });\n\n  /* ---- lettuce ---- */\n  TEX.lettuceMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const n=fbm(u*6,v*6,4), m=fbm(u*30,v*30,2); return [ 90+80*n+20*m, 165+60*n+15*m, 40+40*n ]; });\n    ctx.strokeStyle='rgba(235,250,190,.55)'; ctx.lineCap='round';\n    const c=size/2; for(let i=0;i<14;i++){ const a=i/14*Math.PI*2; ctx.lineWidth=2+rnd()*2; ctx.beginPath(); ctx.moveTo(c,c);\n      let x=c,y=c; for(let s=0;s<6;s++){ x+=Math.cos(a+Math.sin(s*1.7)*.4)*size*.09; y+=Math.sin(a+Math.cos(s*1.3)*.4)*size*.09; ctx.lineTo(x,y);} ctx.stroke(); }\n  },{srgb:true});\n  TEX.lettuceBump=makeTex(S,(ctx,size)=>{ pixelPaint(ctx,size,(u,v)=>{ const g=100+fbm(u*14,v*14,3)*60; return [g,g,g]; }); });\n\n  /* ---- bacon stripes ---- */\n  TEX.baconMap=makeTex(S,(ctx,size)=>{\n    pixelPaint(ctx,size,(u,v)=>{ const s=Math.sin(v*Math.PI*5+Math.sin(u*9)*.8)*.5+.5, n=fbm(u*10,v*10,3);\n      const fat=Math.pow(s,3); return [ lerp(150,235,fat)+20*n, lerp(45,180,fat)+10*n, lerp(30,140,fat) ]; });\n  },{srgb:true});\n  TEX.baconBump=makeTex(S,(ctx,size)=>{ pixelPaint(ctx,size,(u,v)=>{ const g=100+fbm(u*25,v*25,3)*60; return [g,g,g]; }); });\n\n  /* ---- pickle ---- */\n  TEX.pickleTop=makeTex(S,(ctx,size)=>{\n    const c=size/2; const g=ctx.createRadialGradient(c,c,0,c,c,c); g.addColorStop(0,'#c9d67a'); g.addColorStop(.5,'#8fa63a'); g.addColorStop(.85,'#5e7a22'); g.addColorStop(1,'#3e561a');\n    ctx.fillStyle=g; ctx.fillRect(0,0,size,size);\n    ctx.fillStyle='rgba(255,255,220,.5)'; for(let k=0;k<7;k++){ const a=k*.9; ctx.beginPath(); ctx.ellipse(c+Math.cos(a)*size*.2,c+Math.sin(a)*size*.2,size*.03,size*.018,a,0,7); ctx.fill(); }\n  },{srgb:true});\n}\n\nconst MAT = {};\nfunction buildMaterials(){\n  MAT.bunTop = new THREE.MeshStandardMaterial({ map:TEX.bunMap, bumpMap:TEX.bunBump, bumpScale:.035, roughnessMap:TEX.bunRough, roughness:1, metalness:0 });\n  MAT.bunBottom = new THREE.MeshStandardMaterial({ map:TEX.bunBottomMap, bumpMap:TEX.bunBottomBump, bumpScale:.02, roughness:.85 });\n  MAT.patty = new THREE.MeshStandardMaterial({ map:TEX.pattyMap, bumpMap:TEX.pattyBump, bumpScale:.06, roughnessMap:TEX.pattyRough, roughness:1, metalness:.05 });\n  MAT.cheese = new THREE.MeshPhysicalMaterial({ map:TEX.cheeseMap, bumpMap:TEX.cheeseBump, bumpScale:.02, roughnessMap:TEX.cheeseRough, roughness:.45,\n    clearcoat:.8, clearcoatRoughness:.35, transparent:true, opacity:.9, side:THREE.DoubleSide, color:0xffe7a8, emissive:0x3a1e00, emissiveIntensity:.35 });\n  MAT.tomatoSide = new THREE.MeshPhysicalMaterial({ color:0xd8321f, roughness:.25, clearcoat:1, clearcoatRoughness:.15 });\n  MAT.tomatoTop = new THREE.MeshPhysicalMaterial({ map:TEX.tomatoTop, roughnessMap:TEX.tomatoRough, roughness:.4, clearcoat:.9, clearcoatRoughness:.3 });\n  MAT.lettuce = new THREE.MeshStandardMaterial({ map:TEX.lettuceMap, bumpMap:TEX.lettuceBump, bumpScale:.03, roughness:.6, side:THREE.DoubleSide });\n  MAT.lettuce2 = MAT.lettuce.clone(); MAT.lettuce2.color.set(0xcfe8a0);\n  MAT.onion = new THREE.MeshPhysicalMaterial({ color:0xf3e6f5, roughness:.35, transparent:true, opacity:.8, clearcoat:.6, side:THREE.DoubleSide });\n  MAT.onionRim = new THREE.MeshPhysicalMaterial({ color:0xb46bb8, roughness:.35, transparent:true, opacity:.85, clearcoat:.6 });\n  MAT.bacon = new THREE.MeshStandardMaterial({ map:TEX.baconMap, bumpMap:TEX.baconBump, bumpScale:.03, roughness:.55, side:THREE.DoubleSide });\n  MAT.pickleTop = new THREE.MeshPhysicalMaterial({ map:TEX.pickleTop, roughness:.35, clearcoat:.9 });\n  MAT.pickleSide = new THREE.MeshPhysicalMaterial({ color:0x4d6b21, roughness:.35, clearcoat:.9 });\n}\n\n/* ───────────────────────── geometry builders ───────────────────────── */\nfunction displaceAlongNormal(geo, amp, freq, off){\n  geo.computeVertexNormals();\n  const p=geo.attributes.position, n=geo.attributes.normal;\n  for(let i=0;i<p.count;i++){\n    const x=p.getX(i),y=p.getY(i),z=p.getZ(i);\n    const d=(fbm(x*freq+off, z*freq+y*freq*.7, 3)-.5)*amp;\n    p.setXYZ(i, x+n.getX(i)*d, y+n.getY(i)*d, z+n.getZ(i)*d);\n  }\n  p.needsUpdate=true; geo.computeVertexNormals();\n}\nfunction latheFrom(pts, seg){ return new THREE.LatheGeometry(pts.map(a=>new THREE.Vector2(a[0],a[1])), seg||72); }\n\nconst R=1.0;\nconst BUILD = {\n  bunTop(){\n    const H=.62, pts=[[0,0],[.55,0],[.9,0],[.99,.06]];\n    for(let i=1;i<=18;i++){ const t=i/18*Math.PI/2; pts.push([ R*Math.cos(t)*1.0, .08+ (H-.08)*Math.pow(Math.sin(t),.85) ]); }\n    const g=latheFrom(pts,80); displaceAlongNormal(g,.03,3.2,4);\n    const m=new THREE.Mesh(g,MAT.bunTop); m.castShadow=m.receiveShadow=true;\n    return {mesh:m,h:H};\n  },\n  bunBottom(){\n    const H=.36, pts=[[0,0],[.6,0],[.9,.0],[.97,.03],[1,.1],[1,.24],[.97,.32],[.9,.36],[.5,.36],[0,.36]];\n    const g=latheFrom(pts,80); displaceAlongNormal(g,.025,3,11);\n    const m=new THREE.Mesh(g,MAT.bunBottom); m.castShadow=m.receiveShadow=true;\n    return {mesh:m,h:H};\n  },\n  patty(){\n    const H=.3, pts=[[0,0],[.5,0],[.88,0],[.97,.05],[1.02,.15],[.97,.25],[.88,.3],[.5,.3],[0,.3]];\n    const g=latheFrom(pts,90); displaceAlongNormal(g,.07,5,23);\n    const m=new THREE.Mesh(g,MAT.patty); m.castShadow=m.receiveShadow=true;\n    return {mesh:m,h:H};\n  },\n  cheese(){\n    const g=new THREE.PlaneGeometry(1.95,1.95,30,30); g.rotateX(-Math.PI/2);\n    const p=g.attributes.position;\n    for(let i=0;i<p.count;i++){ const x=p.getX(i),z=p.getZ(i), r=Math.hypot(x,z), over=Math.max(0,r-.93);\n      p.setY(i, .03 - over*over*1.0 - Math.max(0,r-.7)*fbm(x*3,z*3,2)*.06); }\n    g.computeVertexNormals();\n    const m=new THREE.Mesh(g,MAT.cheese); m.castShadow=true; m.receiveShadow=true;\n    return {mesh:m,h:.06};\n  },\n  tomato(){\n    const H=.12, g=new THREE.CylinderGeometry(.9,.9,H,64,1); g.translate(0,H/2,0);\n    const m=new THREE.Mesh(g,[MAT.tomatoSide,MAT.tomatoTop,MAT.tomatoTop]); m.castShadow=m.receiveShadow=true;\n    return {mesh:m,h:H};\n  },\n  lettuce(){\n    const grp=new THREE.Group();\n    for(let k=0;k<2;k++){\n      const g=new THREE.CircleGeometry(1.18-k*.12,110); g.rotateX(-Math.PI/2);\n      const p=g.attributes.position, ph=k*1.9;\n      for(let i=0;i<p.count;i++){ const x=p.getX(i),z=p.getZ(i), r=Math.hypot(x,z), a=Math.atan2(z,x), f=Math.pow(r/1.18,2.2);\n        p.setY(i, .02+k*.05 + f*(Math.sin(a*8+ph)*.075+Math.sin(a*13+ph*2)*.03) + fbm(x*4+k,z*4,2)*.04); }\n      g.computeVertexNormals();\n      const m=new THREE.Mesh(g,k?MAT.lettuce2:MAT.lettuce); m.castShadow=m.receiveShadow=true; m.rotation.y=k*1.3; grp.add(m);\n    }\n    return {mesh:grp,h:.12};\n  },\n  onion(){\n    const grp=new THREE.Group();\n    const rings=[[.62,.05,.02],[.45,-.22,.1],[.3,.15,-.28]];\n    rings.forEach((r,i)=>{ const g=new THREE.TorusGeometry(r[0],.032,10,64); g.rotateX(Math.PI/2);\n      const m=new THREE.Mesh(g,i==1?MAT.onionRim:MAT.onion); m.position.set(r[1],.035,r[2]); m.castShadow=true; grp.add(m); });\n    return {mesh:grp,h:.07};\n  },\n  pickle(){\n    const grp=new THREE.Group(), H=.06;\n    const pos=[[.42,.15],[-.38,.28],[.05,-.45],[-.35,-.3]];\n    pos.forEach(pp=>{ const g=new THREE.CylinderGeometry(.27,.27,H,32,1); g.translate(0,H/2,0);\n      const m=new THREE.Mesh(g,[MAT.pickleSide,MAT.pickleTop,MAT.pickleTop]); m.position.set(pp[0],0,pp[1]); m.castShadow=m.receiveShadow=true; grp.add(m); });\n    return {mesh:grp,h:H};\n  },\n  bacon(){\n    const grp=new THREE.Group();\n    for(let k=0;k<2;k++){\n      const g=new THREE.BoxGeometry(2.0,.045,.42,48,1,1); const p=g.attributes.position;\n      for(let i=0;i<p.count;i++){ const x=p.getX(i); p.setY(i, p.getY(i)+.05+Math.sin(x*6.5+k)*.05); }\n      g.computeVertexNormals();\n      const m=new THREE.Mesh(g,MAT.bacon); m.rotation.y=k?-.6:.7; m.position.y=k*.05; m.castShadow=m.receiveShadow=true; grp.add(m);\n    }\n    return {mesh:grp,h:.11};\n  }\n};\n\nconst TYPES = {\n  bunTop:    {name:'نان بالا',     icon:'🍞', price:8000},\n  patty:     {name:'گوشت گریل',    icon:'🥩', price:45000},\n  cheese:    {name:'پنیر آب‌شده',   icon:'🧀', price:12000},\n  tomato:    {name:'گوجه',         icon:'🍅', price:5000},\n  lettuce:   {name:'کاهو',         icon:'🥬', price:4000},\n  onion:     {name:'پیاز',         icon:'🧅', price:3000},\n  pickle:    {name:'خیارشور',      icon:'🥒', price:4000},\n  bacon:     {name:'بیکن',         icon:'🥓', price:25000},\n  bunBottom: {name:'نان پایین',    icon:'🥯', price:8000},\n};\nconst PRESETS = {\n  classic:['bunBottom','patty','cheese','tomato','lettuce','bunTop'],\n  double:['bunBottom','patty','cheese','patty','cheese','onion','pickle','bunTop'],\n  veggie:['bunBottom','lettuce','tomato','onion','pickle','cheese','lettuce','bunTop'],\n  tower:['bunBottom','patty','bacon','cheese','patty','bacon','cheese','tomato','lettuce','bunTop'],\n};\n\n/* ───────────────────────── scene ───────────────────────── */\nlet renderer, scene, camera, burger, ground, layers=[];\nlet asm=0, asmTarget=0;               // 0 = floating / exploded, 1 = fully assembled\nconst GAP=.55;                        // vertical spacing in exploded mode\nconst orbit={theta:.55, phi:1.1, dist:6.4, tTheta:.55, tPhi:1.1, auto:true, lookY:1, tLookY:1};\nconst clock=new THREE.Clock();\n\nfunction initScene(){\n  const canvas=$('#c');\n  renderer=new THREE.WebGLRenderer({canvas, antialias:true, alpha:true, powerPreference:'high-performance'});\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1, 2));\n  renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;\n  renderer.outputEncoding=THREE.sRGBEncoding; renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.05;\n  scene=new THREE.Scene();\n  camera=new THREE.PerspectiveCamera(38,1,.1,100);\n\n  const hemi=new THREE.HemisphereLight(0xfff1dc,0x3a1c0c,.75); scene.add(hemi);\n  const key=new THREE.DirectionalLight(0xfff2e0,1.6); key.position.set(3.5,6,3); key.castShadow=true;\n  key.shadow.mapSize.set(2048,2048); key.shadow.camera.near=1; key.shadow.camera.far=20;\n  key.shadow.camera.left=key.shadow.camera.bottom=-4; key.shadow.camera.right=key.shadow.camera.top=6; key.shadow.bias=-.0006; key.shadow.radius=4;\n  scene.add(key);\n  const rim=new THREE.PointLight(0xffa04a,1.2,20); rim.position.set(-4,3,-3); scene.add(rim);\n  const fill=new THREE.PointLight(0x8ab4ff,.45,20); fill.position.set(-3,2,4); scene.add(fill);\n\n  ground=new THREE.Mesh(new THREE.CircleGeometry(4,48), new THREE.ShadowMaterial({opacity:.32})); ground.rotation.x=-Math.PI/2; ground.receiveShadow=true; scene.add(ground);\n  const plate=new THREE.Mesh(new THREE.CylinderGeometry(1.9,2.0,.06,72), new THREE.MeshPhysicalMaterial({color:0x2b1a12,roughness:.35,clearcoat:.5,metalness:.1}));\n  plate.position.y=-.03; plate.receiveShadow=true; scene.add(plate);\n\n  burger=new THREE.Group(); scene.add(burger);\n  resize(); window.addEventListener('resize',resize);\n}\nfunction resize(){\n  const w=window.innerWidth, h=window.innerHeight;\n  renderer.setSize(w,h,false); camera.aspect=w/h; camera.updateProjectionMatrix();\n}\n\n/* ───────────────────────── layer management ───────────────────────── */\nlet uid=0;\nfunction addLayer(type, index){\n  const b=BUILD[type](); const holder=new THREE.Group(); holder.add(b.mesh);\n  holder.rotation.y=(rnd()-.5)*.6;\n  const L={id:++uid,type,h:b.h,obj:holder,y:null,vy:0};\n  if(index==null||index>layers.length) layers.push(L); else layers.splice(index,0,L);\n  burger.add(holder); relayout(true); renderList(); return L;\n}\nfunction removeLayer(id){\n  const i=layers.findIndex(l=>l.id===id); if(i<0) return;\n  const L=layers.splice(i,1)[0]; burger.remove(L.obj);\n  L.obj.traverse(o=>{ if(o.geometry) o.geometry.dispose(); });\n  relayout(); renderList();\n}\nfunction moveLayer(id,dir){\n  const i=layers.findIndex(l=>l.id===id), j=i+dir; if(i<0||j<0||j>=layers.length) return;\n  [layers[i],layers[j]]=[layers[j],layers[i]]; layers[i].vy+=1.5*dir; layers[j].vy-=1.5*dir; relayout(); renderList();\n}\nfunction clearAll(){ layers.slice().forEach(l=>removeLayer(l.id)); }\nfunction loadPreset(list){ clearAll(); list.forEach(t=>addLayer(t)); asmTarget=1; }\nfunction relayout(spawn){\n  let y=0;\n  layers.forEach((L,i)=>{ L.stackY=y; y+=L.h; L.index=i;\n    if(L.y==null){ L.y = spawn ? y+3.5 : L.stackY; L.vy=0; } });\n  burger.userData.height=y;\n}\nfunction stackTop(){ return burger.userData.height||0; }\n\n/* ───────────────────────── UI ───────────────────────── */\nfunction renderList(){\n  const box=$('#layers'); box.innerHTML='';\n  if(!layers.length){ box.innerHTML='<div class=\"empty\">هنوز لایه‌ای اضافه نشده — از بالا شروع کنید 👆</div>'; }\n  [...layers].reverse().forEach(L=>{\n    const t=TYPES[L.type], el=document.createElement('div'); el.className='layer';\n    el.innerHTML=`<div class=\"nm\"><i>${t.icon}</i>${t.name}</div>\n      <button data-a=\"up\" title=\"بالاتر\" ${L.index===layers.length-1?'disabled':''}>▲</button>\n      <button data-a=\"down\" title=\"پایین‌تر\" ${L.index===0?'disabled':''}>▼</button>\n      <button data-a=\"del\" class=\"del\" title=\"حذف\">✕</button>`;\n    el.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{\n      const a=b.dataset.a; if(a==='del') removeLayer(L.id); else moveLayer(L.id, a==='up'?1:-1); }));\n    box.appendChild(el);\n  });\n  $('#layerCount').textContent=layers.length?fa(layers.length)+' لایه':'';\n  const price=layers.reduce((s,l)=>s+TYPES[l.type].price,0);\n  $('#price').textContent=fa(price.toLocaleString('en-US'))+' تومان';\n}\nfunction buildAddGrid(){\n  const grid=$('#addGrid');\n  Object.keys(TYPES).forEach(k=>{ const t=TYPES[k], b=document.createElement('button'); b.innerHTML=`<b>${t.icon}</b>${t.name}`; b.title='افزودن '+t.name;\n    b.addEventListener('click',()=>{\n      // buns snap to the ends; everything else goes just under the top bun if present\n      let idx=null; if(k==='bunBottom') idx=0; else if(k!=='bunTop' && layers.length && layers[layers.length-1].type==='bunTop') idx=layers.length-1;\n      addLayer(k,idx); pulseHint();\n    }); grid.appendChild(b); });\n}\nfunction syncAsmUI(){ $('#asm').value=Math.round(asmTarget*1000); $('#asmPct').textContent=fa(Math.round(asm*100))+'٪'; }\nfunction pulseHint(){ const h=$('#hint'); h.classList.remove('hide'); clearTimeout(pulseHint.t); pulseHint.t=setTimeout(()=>h.classList.add('hide'),4000); }\nfunction bindUI(){\n  buildAddGrid();\n  $('#asm').addEventListener('input',e=>{ asmTarget=e.target.value/1000; });\n  $('#btnAssemble').addEventListener('click',()=>{ asmTarget=1; });\n  $('#btnExplode').addEventListener('click',()=>{ asmTarget=0; });\n  $('#btnClear').addEventListener('click',clearAll);\n  document.querySelectorAll('[data-preset]').forEach(b=>b.addEventListener('click',()=>loadPreset(PRESETS[b.dataset.preset])));\n  $('#toggleUi').addEventListener('click',()=>$('#ui').classList.toggle('collapsed'));\n  if(window.innerWidth<760) $('#ui').classList.add('collapsed');\n  setTimeout(()=>$('#hint').classList.add('hide'),6000);\n\n  /* wheel = assembly */\n  const canvas=$('#c');\n  canvas.addEventListener('wheel',e=>{ e.preventDefault(); asmTarget=clamp(asmTarget+e.deltaY*.0011,0,1); orbit.auto=false; setTimeout(()=>orbit.auto=true,2500); },{passive:false});\n  /* pointer drag = orbit (horizontal) or assembly (vertical, touch) */\n  let drag=null;\n  canvas.addEventListener('pointerdown',e=>{ drag={x:e.clientX,y:e.clientY,lx:e.clientX,ly:e.clientY,mode:null,asm0:asmTarget}; canvas.setPointerCapture(e.pointerId); canvas.classList.add('grabbing'); orbit.auto=false; });\n  canvas.addEventListener('pointermove',e=>{\n    if(!drag) return; const dx=e.clientX-drag.x, dy=e.clientY-drag.y;\n    if(!drag.mode && Math.hypot(dx,dy)>6) drag.mode = (e.pointerType==='touch' && Math.abs(dy)>Math.abs(dx)*1.4) ? 'asm' : 'orbit';\n    if(drag.mode==='orbit'){ orbit.tTheta -= (e.clientX-drag.lx)*.008; orbit.tPhi = clamp(orbit.tPhi - (e.clientY-drag.ly)*.006, .35, 1.45); }\n    else if(drag.mode==='asm'){ asmTarget=clamp(drag.asm0 + dy/240, 0, 1); }\n    drag.lx=e.clientX; drag.ly=e.clientY;\n  });\n  const end=()=>{ drag=null; canvas.classList.remove('grabbing'); setTimeout(()=>orbit.auto=true,2500); };\n  canvas.addEventListener('pointerup',end); canvas.addEventListener('pointercancel',end);\n  window.addEventListener('keydown',e=>{ if(e.key==='ArrowDown') asmTarget=clamp(asmTarget+.15,0,1); if(e.key==='ArrowUp') asmTarget=clamp(asmTarget-.15,0,1); });\n}\n\n/* ───────────────────────── physics & render loop ───────────────────────── */\nconst K=120, C=8.5;             // spring stiffness / damping → bouncy but settles\nfunction step(dt){\n  asm += (asmTarget-asm)*Math.min(1,dt*6);\n  const t=clock.elapsedTime, n=layers.length;\n  for(let i=0;i<n;i++){\n    const L=layers[i];\n    const float=(1-asm);\n    const target = L.stackY + i*GAP*float + Math.sin(t*1.4+i*.9)*.045*float;\n    const a = K*(target-L.y) - C*L.vy;\n    L.vy += a*dt; L.y += L.vy*dt;\n    // hard floor against the layer below so nothing tunnels\n    if(i>0){ const below=layers[i-1]; const floor=below.y+below.h-.02; if(L.y<floor){ L.y=floor; if(L.vy<0){ below.vy+=L.vy*.35; L.vy*=-.25; } } }\n    else if(L.y<0){ L.y=0; if(L.vy<0) L.vy*=-.3; }\n    L.obj.position.y=L.y;\n    // squash & stretch near landing\n    const near=Math.exp(-Math.abs(target-L.y)*6), sq=near*clamp(Math.abs(L.vy)*.06,0,.22);\n    L.obj.scale.set(1+sq*.5, 1-sq, 1+sq*.5);\n    // gentle drift rotation while floating\n    L.obj.rotation.y += dt*.15*float*(i%2?1:-1);\n    L.obj.rotation.x = Math.sin(t*.9+i)*.05*float;\n    L.obj.rotation.z = Math.cos(t*.7+i*1.3)*.05*float;\n  }\n  /* camera */\n  if(orbit.auto) orbit.tTheta += dt*.18;\n  orbit.theta += (orbit.tTheta-orbit.theta)*Math.min(1,dt*6);\n  orbit.phi   += (orbit.tPhi-orbit.phi)*Math.min(1,dt*6);\n  const totalH = stackTop() + (n?(n-1)*GAP*(1-asm):0);\n  orbit.tLookY = Math.max(.7, totalH*.5);\n  orbit.lookY += (orbit.tLookY-orbit.lookY)*Math.min(1,dt*4);\n  const aspect=camera.aspect, narrow=aspect<1;\n  const tDist = (5.2 + Math.max(0,totalH-2.2)*.95) * (narrow ? Math.min(3.2, 1.2/aspect) : 1);\n  orbit.dist += (tDist-orbit.dist)*Math.min(1,dt*4);\n  // on portrait phones the panel covers the lower half, so aim below the burger to push it up on screen\n  const aimY = orbit.lookY - (narrow ? .45 : 0);\n  camera.position.set( Math.sin(orbit.theta)*Math.sin(orbit.phi)*orbit.dist, Math.cos(orbit.phi)*orbit.dist+orbit.lookY*.6, Math.cos(orbit.theta)*Math.sin(orbit.phi)*orbit.dist );\n  camera.lookAt(0,aimY,0);\n  syncAsmUI();\n}\nfunction loop(){\n  const dt=Math.min(clock.getDelta(), .05);\n  // sub-step the spring for stability on slow frames\n  const sub=2; for(let s=0;s<sub;s++) step(dt/sub);\n  renderer.render(scene,camera);\n  requestAnimationFrame(loop);\n}\n\n/* ───────────────────────── boot ───────────────────────── */\ntry{\n  if(!window.THREE) throw new Error('three missing');\n  const test=document.createElement('canvas'); if(!(test.getContext('webgl2')||test.getContext('webgl'))) throw new Error('no webgl');\n  buildTextures(); buildMaterials(); initScene(); bindUI();\n  loadPreset(PRESETS.classic); asmTarget=0; asm=0;   // start floating so the first scroll assembles it\n  document.addEventListener('visibilitychange',()=>{ if(!document.hidden) clock.getDelta(); });\n  loop();\n}catch(err){\n  console.error(err);\n  $('#err').style.display='flex'; $('#ui').style.display='none'; $('#hint').style.display='none';\n}\n})();\n</script>\n</body>\n</html>\n"}]}